{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperjammednet",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  // `binding` makes env.ASSETS exist inside the Worker. Without it, any path
  // that isn't a real file (and isn't one of the Worker's own routes) threw
  // "env.ASSETS is undefined" and showed Cloudflare's error 1101.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Workers AI — generates "Temple of Unhinged Testpages" template's daily
  // content. Free-tier binding, no separate API key needed.
  "ai": {
    "binding": "AI"
  },

  // Cron Trigger — fires scheduled() in src/index.js once a day. This is
  // the ONLY code path that calls the model; nothing a visitor does can
  // trigger a generation. 9am UTC, adjust to taste.
  "triggers": {
    // The second entry is a one-off test run at 12:45 UTC on 5 October
    // (it next matches in 2027); remove it once the daily run is confirmed.
    "crons": ["0 9 * * *", "45 12 5 10 *"]
  },

  "kv_namespaces": [
    {
      "binding": "DAILY_TEMPLATE",
      "id": "0a148b477f20418782bc83163d143b86"
    }
  ],

  // Branch/PR preview builds run `wrangler preview`, which refuses to run
  // without this block. Previews do NOT inherit top-level bindings, so the
  // ones the site reads are repeated here. Cron triggers can't be set on
  // previews, so a preview never runs scheduled() or writes to KV.
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "kv_namespaces": [
      {
        "binding": "DAILY_TEMPLATE",
        "id": "0a148b477f20418782bc83163d143b86"
      }
    ]
  }
}
